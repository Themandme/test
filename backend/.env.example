# Copy to .env for local dev. NEVER commit real secrets.

# --- Storage ---
DATABASE_URL=sqlite:///./senior_directory.db

# --- Activation payload signing (Ed25519) ---
# 32-byte seed, base64-encoded. Generate one with:
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
# Leave blank in dev to use an ephemeral key (rotates on restart).
SIGNING_KEY_SEED_B64=

# --- Stripe (web checkout funnel) ---
# Leave STRIPE_API_KEY blank for local dev: the funnel uses a SIMULATED checkout that
# provisions an account immediately so you can test end-to-end without Stripe.
STRIPE_API_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# Stripe price IDs for the two web-checkout plans (both grant Premium).
STRIPE_PRICE_MONTHLY=price_xxx_monthly
STRIPE_PRICE_YEARLY=price_xxx_yearly
# Optional extra price IDs that also grant Premium.
STRIPE_PREMIUM_PRICE_IDS=

# Public base URL of the web funnel (Stripe success/cancel redirects + CORS).
WEB_BASE_URL=http://localhost:5173

# --- Tiering ---
FREE_TIER_MAX_CUSTOM_CONTACTS=3
