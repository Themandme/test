# Production environment template. Set these as real secrets in your platform's
# secret manager — never commit real values.

ENVIRONMENT=production

# Real database (Postgres). SQLite is rejected at startup in production.
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/senior_directory

# Stable Ed25519 signing seed (REQUIRED in prod — no ephemeral keys).
#   python -c "import os,base64;print(base64.b64encode(os.urandom(32)).decode())"
SIGNING_KEY_SEED_B64=

# Stripe
STRIPE_API_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_live_monthly
STRIPE_PRICE_YEARLY=price_live_yearly

# Public web funnel origin (https). Used for redirects + CORS.
WEB_BASE_URL=https://safe-numbers.app
EXTRA_CORS_ORIGINS=

# Dev provisioning endpoint MUST be off in production.
ENABLE_DEV_ENDPOINTS=false

# Behind a load balancer? Gunicorn trusts XFF only from these proxy IPs.
FORWARDED_ALLOW_IPS=10.0.0.0/8
WEB_CONCURRENCY=3
